@page
@model pharamcy.web.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "My Cart";
}

<div style="min-height:100vh; background:#eef1f8; padding:40px 16px; font-family:'Segoe UI',sans-serif;">
    <div style="max-width:600px; margin:0 auto;">

        <!-- Header -->
        <div style="text-align:center; margin-bottom:32px;">
            <div style="font-size:48px;">🛒</div>
            <h1 style="font-size:26px; font-weight:700; color:#1a1a2e;">My Cart</h1>
        </div>

        @if (!Model.CartItems.Any())
        {
            <div style="text-align:center; background:white; border-radius:16px; padding:40px; color:#6b7280;">
                <p style="font-size:18px;">Your cart is empty</p>
                <a asp-page="/NearestPharmacies"
                   style="color:#2563eb; font-weight:600; text-decoration:none;">← Back to Pharmacies</a>
            </div>
        }
        else
        {
            <!-- Cart Items -->
            @foreach (var item in Model.CartItems)
            {
                <div style="background:white; border-radius:16px; padding:16px 20px; margin-bottom:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <div style="font-weight:700; color:#1a1a2e; font-size:16px;">@item.MedicineName</div>
                        <div style="color:#6b7280; font-size:14px; margin-top:4px;">
                            Qty: @item.Quantity × @item.UnitPrice.ToString("0.00") EGP
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <span style="font-weight:700; color:#2563eb;">@item.Total.ToString("0.00") EGP</span>
                        <form method="post" asp-page-handler="Remove">
                            <input type="hidden" name="medicineName" value="@item.MedicineName" />
                            <input type="hidden" asp-for="PharmacyId" />
                            <button type="submit"
                                    style="background:#fee2e2; color:#dc2626; border:none; border-radius:8px; padding:6px 10px; cursor:pointer; font-weight:600;">
                                ✕
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Total -->
            <div style="background:white; border-radius:16px; padding:16px 20px; margin-bottom:20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <div style="display:flex; justify-content:space-between; font-size:18px; font-weight:700; color:#1a1a2e;">
                    <span>Total</span>
                    <span style="color:#2563eb;">@Model.Total.ToString("0.00") EGP</span>
                </div>
            </div>

            <!-- Confirm Form -->
            <form method="post" asp-page-handler="Confirm" enctype="multipart/form-data">
                <input type="hidden" asp-for="PharmacyId" />
                <input type="hidden" id="prescriptionData" name="PrescriptionData" />


                <div style="margin-bottom:16px;">
                    <label style="font-weight:600; color:#374151; display:block; margin-bottom:8px;">Delivery Address</label>
                    <input asp-for="DeliveryAddress"
                           style="width:100%; padding:12px 16px; border:1.5px solid #e5e7eb; border-radius:10px; font-size:15px; outline:none; box-sizing:border-box;" />
                </div>

                <div style="margin-bottom:20px;">
                    <label style="font-weight:600; color:#374151; display:block; margin-bottom:8px;">Notes (Optional)</label>
                    <textarea asp-for="Notes" rows="3"
                              style="width:100%; padding:12px 16px; border:1.5px solid #e5e7eb; border-radius:10px; font-size:15px; outline:none; resize:vertical; box-sizing:border-box;"
                              placeholder="Any additional notes..."></textarea>
                </div>

                <button type="submit"
                        style="width:100%; background:#2563eb; color:white; border:none; border-radius:12px; padding:14px; font-size:16px; font-weight:700; cursor:pointer;">
                    ✅ Confirm Order
                </button>
            </form>
        }
    </div>
</div>

<script>
    // ✅ جيب الصورة من sessionStorage وحطها في الـ Hidden Field
    window.onload = function() {
        const prescriptionImage = sessionStorage.getItem('prescriptionImage');
        if (prescriptionImage) {
            document.getElementById('prescriptionData').value = prescriptionImage;
        }
    }
</script>