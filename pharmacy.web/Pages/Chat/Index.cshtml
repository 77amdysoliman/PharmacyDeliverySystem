@page 
@model Pharmacy.web.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "Pharmacy Assistant";
}

<style>
    .chat-wrap { display:flex; flex-direction:column; height:calc(100vh - 140px); max-width:700px; margin:30px auto; background:white; border-radius:20px; box-shadow:0 4px 24px rgba(0,0,0,0.08); overflow:hidden; }
    .chat-header { background:#2563eb; padding:18px 24px; }
    .chat-header h2 { color:#fff; font-size:17px; font-weight:600; margin:0 0 3px; }
    .chat-header p { color:#bfdbfe; font-size:13px; margin:0; }
    .chat-messages { flex:1; overflow-y:auto; padding:20px; display:flex; flex-direction:column; gap:14px; background:white; }
    .msg { display:flex; gap:10px; align-items:flex-start; }
    .msg.user { flex-direction:row-reverse; }
    .avatar { width:34px; height:34px; border-radius:50%; background:#dbeafe; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; color:#1d4ed8; font-weight:600; }
    .msg.user .avatar { background:#2563eb; color:#fff; }
    .bubble { max-width:78%; padding:11px 15px; border-radius:16px; font-size:14px; line-height:1.6; }
    .bot .bubble { background:#f8fafc; border:1px solid #e2e8f0; color:#1e293b; }
    .user .bubble { background:#2563eb; color:#fff; }
    .time { font-size:11px; color:#94a3b8; margin-top:4px; }
    .med-card { margin-top:10px; background:white; border:1px solid #e2e8f0; border-radius:12px; padding:12px 14px; display:flex; justify-content:space-between; align-items:center; gap:10px; box-shadow:0 1px 4px rgba(0,0,0,0.05); }
    .med-info { display:flex; flex-direction:column; gap:2px; }
    .med-name { font-size:13px; font-weight:600; color:#1e293b; }
    .med-price { font-size:12px; color:#64748b; }
    .order-btn { background:#2563eb; color:#fff; border:none; padding:7px 16px; border-radius:8px; font-size:12px; cursor:pointer; font-weight:600; white-space:nowrap; flex-shrink:0; text-decoration:none; }
    .order-btn:hover { background:#1d4ed8; color:white; }
    .typing { display:flex; gap:4px; align-items:center; padding:11px 15px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:16px; width:fit-content; }
    .dot { width:6px; height:6px; border-radius:50%; background:#94a3b8; animation:bounce 1s infinite; }
    .dot:nth-child(2) { animation-delay:.2s; }
    .dot:nth-child(3) { animation-delay:.4s; }
    @@keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
    .chat-input { display:flex; gap:10px; padding:14px 18px; background:white; border-top:1px solid #e2e8f0; }
    .chat-input input { flex:1; padding:11px 16px; border:1.5px solid #e2e8f0; border-radius:12px; font-size:14px; outline:none; font-family:inherit; color:#1e293b; }
    .chat-input input:focus { border-color:#2563eb; }
    .send-btn { width:42px; height:42px; background:#2563eb; border:none; border-radius:12px; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .send-btn:hover { background:#1d4ed8; }
    .send-btn svg { width:17px; height:17px; fill:#fff; }
    .disclaimer { font-size:11px; color:#94a3b8; margin-top:8px; }
</style>

<div class="chat-wrap">
    <div class="chat-header">
        <h2>💊 Pharmacy Assistant</h2>
        <p>Ask about any medicine or symptoms / اسأل عن أي دواء أو أعراض</p>
    </div>

    <div class="chat-messages" id="messages">
        <div class="msg bot">
            <div class="avatar">+</div>
            <div>
                <div class="bubble">
                    Hello! I'm your pharmacy assistant. Describe your symptoms and I'll suggest the right medicines!<br><br>
                    مرحباً! صف أعراضك وسأقترح لك الأدوية المناسبة!
                </div>
                <div class="time" id="start-time"></div>
            </div>
        </div>
    </div>

    <div class="chat-input">
        <input type="text" id="userInput" placeholder="e.g. headache and fever / صداع وحرارة" />
        <button class="send-btn" onclick="sendMessage()">
            <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z" /></svg>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const medicines = {
            headache:  { name:"Paracetamol 500mg", nameAr:"باراسيتامول 500 مجم", price:"10 EGP", id:4 },
            fever:     { name:"Paracetamol 500mg", nameAr:"باراسيتامول 500 مجم", price:"10 EGP", id:4 },
            cold:      { name:"Vitamin C 1000mg",  nameAr:"فيتامين سي 1000 مجم", price:"20 EGP", id:7 },
            allergy:   { name:"Cetirizine 10mg",   nameAr:"سيتيريزين 10 مجم",    price:"14 EGP", id:14 },
            pain:      { name:"Ibuprofen 400mg",   nameAr:"إيبوبروفين 400 مجم",  price:"15 EGP", id:5 },
            stomach:   { name:"Omeprazole 20mg",   nameAr:"أوميبرازول 20 مجم",   price:"22 EGP", id:16 },
            infection: { name:"Amoxicillin 500mg", nameAr:"أموكسيسيلين 500 مجم", price:"25 EGP", id:1 },
            diabetes:  { name:"Metformin 500mg",   nameAr:"ميتفورمين 500 مجم",   price:"12 EGP", id:10 },
            skin:      { name:"Hydrocortisone Cream 1%", nameAr:"كريم هيدروكورتيزون 1%", price:"25 EGP", id:18 },
            cough:     { name:"Domperidone 10mg",  nameAr:"دومبيريدون 10 مجم",   price:"18 EGP", id:17 },
            vitamin:   { name:"Vitamin D3 1000IU", nameAr:"فيتامين د3 1000 وحدة", price:"35 EGP", id:8 },
            zinc:      { name:"Zinc 50mg",         nameAr:"زنك 50 مجم",           price:"18 EGP", id:9 },
             pressure:  { name:"Amlodipine 5mg",    nameAr:"أملوديبين 5 مجم",      price:"28 EGP", id:13 },
            cholesterol: { name:"Atorvastatin 20mg", nameAr:"أتورفاستاتين 20 مجم", price:"40 EGP", id:12 },
            antibiotic2: { name:"Azithromycin 250mg", nameAr:"أزيثروميسين 250 مجم", price:"45 EGP", id:2 },
            allergy2:  { name:"Loratadine 10mg",   nameAr:"لوراتادين 10 مجم",     price:"16 EGP", id:15 },
            aspirin:   { name:"Aspirin 100mg",     nameAr:"أسبرين 100 مجم",       price:"8 EGP",  id:6 },
        };

        const keywords = {
            headache:  ["headache","صداع","head","راسي","رأسي"],
            fever:     ["fever","حرارة","temperature","سخونة","حمى"],
            cold:      ["cold","برد","flu","زكام","رشح"],
            allergy:   ["allergy","حساسية","allergic","itching","حكة"],
            pain:      ["pain","وجع","ache","ألم","بوجع"],
            stomach:   ["stomach","معدة","gastric","حموضة","acid","بطن"],
            infection: ["infection","bacteria","بكتيريا","التهاب","عدوى"],
            diabetes:  ["diabetes","سكر","sugar","diabetic","السكري"],
            skin:      ["skin","جلد","rash","طفح","جلدي"],
            cough:     ["cough","كحة","سعال"],
            vitamin:   ["tired","تعب","إرهاق","fatigue","ضعف"],
            zinc:      ["immune","مناعة","immunity"],
            pressure:    ["pressure","ضغط","blood pressure","ضغط الدم","hypertension","ضغط عالي","ضغطي"],
            cholesterol: ["cholesterol","كوليسترول","دهون","triglycerides","دهون الدم"],
            antibiotic2: ["throat","حلق","tonsil","لوز","التهاب حلق","وجع حلق"],
            allergy2:    ["runny nose","سيلان","رشح انف","رشح أنف","واخد برد"],
            aspirin:     ["aspirin","أسبرين","blood thin","تخفيف الدم","قلب"],
        };

        const responses = {
            en: {
                found: "Based on your symptoms, I recommend:",
                notFound: "I'm not sure about that. Try describing symptoms like: headache, fever, cold, allergy, pain, stomach, infection, diabetes, skin problems, or fatigue.",
                orderBtn: (med) => `Order — ${med.price}`,
                disclaimer: "⚠️ Always consult a doctor before taking any medicine.",
            },
            ar: {
                found: "بناءً على أعراضك، أنصحك بالأدوية التالية:",
                notFound: "لم أفهم أعراضك جيداً. حاول وصف أعراض مثل: صداع، حرارة، برد، حساسية، وجع، معدة، التهاب، سكر، مشاكل جلدية، أو تعب.",
                orderBtn: (med) => `اطلب — ${med.price}`,
                disclaimer: "⚠️ استشر الطبيب دائماً قبل تناول أي دواء.",
            }
        };

        function isArabic(text) { return /[\u0600-\u06FF]/.test(text); }
        function getTime() { return new Date().toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'}); }
        document.getElementById('start-time').textContent = getTime();

        function detectMedicines(text) {
            const lower = text.toLowerCase();
            const found = [];
            const addedIds = new Set();
            for (const [condition, words] of Object.entries(keywords)) {
                if (words.some(w => lower.includes(w))) {
                    const med = medicines[condition];
                    if (!addedIds.has(med.id)) {
                        addedIds.add(med.id);
                        found.push(med);
                    }
                }
            }
            return found;
        }

        function addUserMsg(text, lang) {
            const msgs = document.getElementById('messages');
            const dir = lang === 'ar' ? 'rtl' : 'ltr';
            const div = document.createElement('div');
            div.className = 'msg user';
            div.innerHTML = `
                <div class="avatar">U</div>
                <div>
                    <div class="bubble" style="direction:${dir}">${text}</div>
                    <div class="time">${getTime()}</div>
                </div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

      function addBotMsg(meds, lang) {
    const msgs = document.getElementById('messages');
    const dir = lang === 'ar' ? 'rtl' : 'ltr';
    const r = responses[lang];
    
    let cardsHtml = '';
    meds.forEach((med, index) => {
        const medName = lang === 'ar' ? med.nameAr : med.name;
        const colors = ['#eff6ff', '#f0fdf4', '#fef9c3', '#fdf4ff', '#fff1f2'];
        const iconColors = ['#2563eb', '#16a34a', '#d97706', '#9333ea', '#dc2626'];
        const bg = colors[index % colors.length];
        const ic = iconColors[index % iconColors.length];
        cardsHtml += `
            <div style="margin-top:10px; background:${bg}; border-radius:14px; padding:14px 16px; display:flex; justify-content:space-between; align-items:center; gap:10px;">
                <div style="display:flex; align-items:center; gap:12px;">
                    <div style="width:40px; height:40px; background:white; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; box-shadow:0 2px 8px rgba(0,0,0,0.08);">💊</div>
                    <div>
                        <div style="font-size:14px; font-weight:700; color:#1e293b;">${medName}</div>
                        <div style="font-size:12px; color:#64748b; margin-top:2px;">${med.price}</div>
                    </div>
                </div>
                <a href="/Orders/Orders?MedicineName=${encodeURIComponent(med.name)}"
                   style="background:${ic}; color:white; border:none; padding:8px 16px; border-radius:10px; font-size:12px; cursor:pointer; font-weight:600; white-space:nowrap; text-decoration:none;">
                   ${lang === 'ar' ? '🛒 اطلب' : '🛒 Order'}
                </a>
            </div>`;
    });

    const countText = meds.length > 1 
        ? (lang === 'ar' ? `وجدت ${meds.length} أدوية مناسبة:` : `Found ${meds.length} suitable medicines:`)
        : r.found;

    const div = document.createElement('div');
    div.className = 'msg bot';
    div.innerHTML = `
        <div class="avatar">+</div>
        <div style="max-width:82%">
            <div class="bubble" style="direction:${dir}; background:#f8fafc; border:1px solid #e2e8f0; padding:14px 16px;">
                <div style="font-size:13px; font-weight:600; color:#374151; margin-bottom:4px;">${countText}</div>
                ${cardsHtml}
                <div style="font-size:11px; color:#94a3b8; margin-top:12px; padding-top:10px; border-top:1px solid #e2e8f0;">
                    ${r.disclaimer}
                </div>
            </div>
            <div class="time">${getTime()}</div>
        </div>`;
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
}

    function addNotFoundMsg(lang) {
    const msgs = document.getElementById('messages');
    const dir = lang === 'ar' ? 'rtl' : 'ltr';
    const div = document.createElement('div');
    div.className = 'msg bot';

    const suggestions = lang === 'ar'
        ? ['صداع', 'حرارة', 'برد', 'ضغط', 'سكر', 'كوليسترول', 'حساسية', 'معدة']
        : ['headache', 'fever', 'cold', 'pressure', 'diabetes', 'allergy', 'stomach'];

    const suggestionsHtml = suggestions.map(s => `
        <button onclick="document.getElementById('userInput').value='${s}'; sendMessage();"
                style="background:#f1f5f9; color:#374151; border:none; padding:6px 14px; border-radius:20px; font-size:12px; cursor:pointer; font-weight:500; margin:3px;">
            ${s}
        </button>`).join('');

    div.innerHTML = `
        <div class="avatar">+</div>
        <div style="max-width:82%">
            <div class="bubble" style="direction:${dir}; background:#fff7ed; border:1px solid #fed7aa;">
                <div style="font-size:14px; color:#92400e; margin-bottom:10px;">
                    ${lang === 'ar' 
                        ? '😕 لم أتعرف على الأعراض. جرب من هذه الأمثلة:' 
                        : '😕 I didn\'t recognize those symptoms. Try one of these:'}
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:4px; margin-bottom:12px;">
                    ${suggestionsHtml}
                </div>
                <a href="/Orders/Orders"
                   style="display:block; text-align:center; background:#2563eb; color:white; padding:10px; border-radius:10px; text-decoration:none; font-size:13px; font-weight:600;">
                    ${lang === 'ar' ? '🔍 تصفح كل الأدوية' : '🔍 Browse All Medicines'}
                </a>
            </div>
            <div class="time">${getTime()}</div>
        </div>`;
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
}

        function showTyping() {
            const msgs = document.getElementById('messages');
            const div = document.createElement('div');
            div.className = 'msg bot';
            div.id = 'typing';
            div.innerHTML = `<div class="avatar">+</div><div class="typing"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function removeTyping() {
            const t = document.getElementById('typing');
            if (t) t.remove();
        }

        function sendMessage() {
            const input = document.getElementById('userInput');
            const text = input.value.trim();
            if (!text) return;
            input.value = '';
            const lang = isArabic(text) ? 'ar' : 'en';
            addUserMsg(text, lang);
            showTyping();
            setTimeout(() => {
                removeTyping();
                const meds = detectMedicines(text);
                if (meds.length > 0) addBotMsg(meds, lang);
                else addNotFoundMsg(lang);
            }, 1200);
        }

        document.getElementById('userInput').addEventListener('keypress', e => {
            if (e.key === 'Enter') sendMessage();
        });
    </script>
}