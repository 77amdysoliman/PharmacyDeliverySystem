@page
@model pharmacy.web.Pages.Contact.ContactModel
@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5" style="color: #0f172a;">Contact Us</h2>
        <p class="text-muted">Have a question? We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>
    </div>

    <div class="row g-4 mb-5 text-center">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 custom-card">
                <div class="icon-box mx-auto mb-3" style="background-color: #e0f2fe; color: #3b82f6;">
                    <i class="bi bi-telephone-fill fs-4"></i>
                </div>
                <h5 class="fw-bold">Phone</h5>
                <p class="mb-1 text-muted">+20 123 456 7890</p>
                <p class="text-muted">+20 987 654 3210</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 custom-card">
                <div class="icon-box mx-auto mb-3" style="background-color: #dcfce7; color: #22c55e;">
                    <i class="bi bi-envelope-fill fs-4"></i>
                </div>
                <h5 class="fw-bold">Email</h5>
                <p class="mb-1 text-muted">info@pharmacy.com</p>
                <p class="text-muted">support@pharmacy.com</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 custom-card">
                <div class="icon-box mx-auto mb-3" style="background-color: #f3e8ff; color: #a855f7;">
                    <i class="bi bi-geo-alt-fill fs-4"></i>
                </div>
                <h5 class="fw-bold">Address</h5>
                <p class="mb-1 text-muted">Cairo, Egypt</p>
                <p class="text-muted">Heliopolis, 11341</p>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 p-md-5">
                <h3 class="fw-bold mb-4">Send us a Message</h3>

                @* Success Message *@
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post">
                    <div class="row g-3">

                        @* Name *@
                        <div class="col-md-12">
                            <label asp-for="Input.Name" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Name"
                                   class="form-control form-control-lg bg-light border-0"
                                   placeholder="John Doe" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>

                        @* Email *@
                        <div class="col-md-12">
                            <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg bg-light border-0"
                                   placeholder="john@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        @* Phone *@
                        <div class="col-md-12">
                            <label asp-for="Input.Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Phone"
                                   class="form-control form-control-lg bg-light border-0"
                                   placeholder="01234567890" />
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>

                        @* Subject *@
                        <div class="col-md-12">
                            <label asp-for="Input.Subject" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Subject"
                                   class="form-control form-control-lg bg-light border-0"
                                   placeholder="How can we help?" />
                            <span asp-validation-for="Input.Subject" class="text-danger small"></span>
                        </div>

                        @* Message *@
                        <div class="col-md-12">
                            <label asp-for="Input.Message" class="form-label fw-semibold"></label>
                            <textarea asp-for="Input.Message"
                                      class="form-control bg-light border-0"
                                      rows="5"
                                      placeholder="Write your message here..."></textarea>
                            <span asp-validation-for="Input.Message" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12 mt-4">
                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100 py-3 fw-bold shadow-sm"
                                    style="background-color: #2563eb; border: none;">
                                <i class="bi bi-send-fill me-2"></i> Send Message
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<style>
    body { background-color: #f8fafc; }

    .custom-card {
        border-radius: 15px;
        transition: transform 0.3s ease;
    }
    .custom-card:hover { transform: translateY(-5px); }

    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-control:focus {
        background-color: #fff !important;
        border-color: #2563eb !important;
        box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.1) !important;
    }
</style>