@page
@model pharmacy.web.Pages.Admin.PharmaciesModel
@{
    
    Layout = "_LayoutAdmin";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: #eef2fb;
        color: #1e293b;
    }

    .page-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 24px;
    }

    .page-header {
        margin-bottom: 28px;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 700;
    }

    .page-subtitle {
        font-size: 0.9rem;
        color: #64748b;
        margin-top: 4px;
    }

    .search-wrapper {
        background: #fff;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 28px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }

    .search-box {
        display: flex;
        gap: 10px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 16px;
        background: #f8fafc;
    }

        .search-box input {
            border: none;
            outline: none;
            width: 100%;
            background: transparent;
        }

    .pharmacy-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .pharmacy-card {
        background: #fff;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
    }

    .badge {
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 999px;
    }

        .badge.active {
            background: #dcfce7;
            color: #16a34a;
        }

        .badge.pending {
            background: #fef9c3;
            color: #ca8a04;
        }

    .card-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.875rem;
    }

    .card-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .btn {
        padding: 10px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-edit {
        background: #2563eb;
        color: #fff;
    }

    .btn-delete {
        background: #dc2626;
        color: #fff;
    }

    .btn-approve {
        width: 100%;
        margin-top: 10px;
        background: #16a34a;
        color: #fff;
        padding: 10px;
        border-radius: 10px;
    }
</style>

<div class="page-wrapper">

    <div class="page-header">
        <h2 class="page-title">Manage Pharmacies</h2>
        <p class="page-subtitle">View and track all registered pharmacies</p>
    </div>

    <div class="search-wrapper">
        <div class="search-box">
            <input id="searchInput" type="text" placeholder="Search for pharmacy..." />
        </div>
    </div>

    <div class="pharmacy-grid">

        @foreach (var p in Model.Pharmacies)
        {
            <div class="pharmacy-card" data-name="@p.Name.ToLower()">

                <div class="card-header">
                    <h4>@p.Name</h4>

                    @if (p.IsActive)
                    {
                        <span class="badge active">Active</span>
                    }
                    else
                    {
                        <span class="badge pending">Under Review</span>
                    }
                </div>

                <div class="card-info">
                    <div class="info-row">
                        <span>Owner</span>
                        <span>@p.OwnerName</span>
                    </div>

                    <div class="info-row">
                        <span>Phone</span>
                        <span>@p.Phone</span>
                    </div>

                    <div class="info-row">
                        <span>Orders</span>
                        <span>@p.OrdersCount</span>
                    </div>

                    <div class="info-row">
                        <span>Rating</span>
                        <span>@p.Rating ⭐</span>
                    </div>
                </div>

                <div class="card-actions">
                    <a asp-page="/Admin/EditPharmacy" asp-route-id="@p.Id" class="btn btn-edit">
                        Edit
                    </a>

                    <button class="btn btn-delete" onclick="confirmDelete(@p.Id)">
                        Delete
                    </button>
                </div>

                @if (!p.IsActive)
                {
                    <form method="post" asp-page-handler="Approve">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button class="btn btn-approve">Approve</button>
                    </form>
                }

            </div>
        }

    </div>
</div>

<script>
    document.getElementById('searchInput').addEventListener('input', function () {
        const query = this.value.toLowerCase();

        document.querySelectorAll('.pharmacy-card').forEach(card => {
            const name = card.getAttribute('data-name');
            card.style.display = name.includes(query) ? '' : 'none';
        });
    });

    function confirmDelete(id) {
        if (confirm('Are you sure you want to delete this pharmacy?')) {
            fetch(`/Admin/Pharmacies?handler=Delete&id=${id}`, {
                method: 'POST'
            }).then(() => location.reload());
        }
    }
</script>