@page "{id:int}"
@model pharmacy.web.Pages.Admin.EditPharmacyModel
@{
    Layout = "_LayoutAdmin";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body { font-family: 'DM Sans', sans-serif; background: #eef2fb; color: #1e293b; }

    .page-wrapper { max-width: 700px; margin: 0 auto; padding: 40px 24px; }

    .page-header { margin-bottom: 28px; display: flex; align-items: center; gap: 14px; }

    .back-btn {
        background: #fff; border: 1.5px solid #e2e8f0; border-radius: 10px;
        padding: 8px 14px; font-size: 0.875rem; font-weight: 600;
        color: #475569; text-decoration: none; display: flex; align-items: center; gap: 6px;
    }
    .back-btn:hover { background: #f1f5f9; }

    .page-title { font-size: 1.5rem; font-weight: 700; }

    .form-card {
        background: #fff; border-radius: 16px; padding: 28px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }

    label { font-size: 0.875rem; font-weight: 600; color: #374151; }

    input[type="text"],
    input[type="tel"],
    input[type="number"],
    textarea {
        border: 1.5px solid #e2e8f0; border-radius: 10px;
        padding: 10px 14px; font-size: 0.9rem; font-family: 'DM Sans', sans-serif;
        outline: none; transition: border-color .2s;
        background: #f8fafc; width: 100%;
    }
    input:focus, textarea:focus { border-color: #2563eb; background: #fff; }

    textarea { resize: vertical; min-height: 90px; }

    .toggle-row {
        display: flex; align-items: center; justify-content: space-between;
        background: #f8fafc; border: 1.5px solid #e2e8f0;
        border-radius: 10px; padding: 12px 16px;
    }
    .toggle-label { font-size: 0.9rem; font-weight: 500; }

    .toggle { position: relative; width: 44px; height: 24px; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .slider {
        position: absolute; inset: 0; background: #cbd5e1;
        border-radius: 999px; cursor: pointer; transition: background .2s;
    }
    .slider:before {
        content: ''; position: absolute; width: 18px; height: 18px;
        background: #fff; border-radius: 50%; top: 3px; left: 3px; transition: transform .2s;
    }
    .toggle input:checked + .slider { background: #16a34a; }
    .toggle input:checked + .slider:before { transform: translateX(20px); }

    .form-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }

    .btn {
        padding: 12px; border: none; border-radius: 10px; cursor: pointer;
        font-weight: 600; font-size: 0.9rem; display: flex;
        align-items: center; justify-content: center; gap: 6px; text-decoration: none;
    }
    .btn-save   { background: #2563eb; color: #fff; }
    .btn-save:hover { background: #1d4ed8; }
    .btn-cancel { background: #f1f5f9; color: #475569; }
    .btn-cancel:hover { background: #e2e8f0; }

    .alert-success {
        background: #dcfce7; color: #16a34a; border-radius: 10px;
        padding: 12px 16px; font-size: 0.875rem; font-weight: 600;
        margin-bottom: 20px; display: flex; align-items: center; gap: 8px;
    }
    .alert-danger {
        background: #fee2e2; color: #dc2626; border-radius: 10px;
        padding: 12px 16px; font-size: 0.875rem; font-weight: 600;
        margin-bottom: 20px; display: flex; align-items: center; gap: 8px;
    }
</style>

<div class="page-wrapper">

    <div class="page-header">
        <a asp-page="/Admin/Pharmacies" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
        <div>
            <h2 class="page-title">Edit Pharmacy</h2>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">
            <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
        </div>
    }

    <div class="form-card">
        <form method="post">
            <input type="hidden" asp-for="Input.Id" />

            <div class="form-group">
                <label asp-for="Input.Name">Pharmacy Name</label>
                <input asp-for="Input.Name" type="text" placeholder="e.g. El Ezaby Pharmacy" />
                <span asp-validation-for="Input.Name" style="color:#dc2626; font-size:0.8rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Address">Address</label>
                <input asp-for="Input.Address" type="text" placeholder="e.g. Cairo, Heliopolis" />
                <span asp-validation-for="Input.Address" style="color:#dc2626; font-size:0.8rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Phone">Phone</label>
                <input asp-for="Input.Phone" type="tel" placeholder="e.g. 01234567890" />
                <span asp-validation-for="Input.Phone" style="color:#dc2626; font-size:0.8rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Rating">Rating</label>
                <input asp-for="Input.Rating" type="number" step="0.1" min="0" max="5" placeholder="0.0 - 5.0" />
                <span asp-validation-for="Input.Rating" style="color:#dc2626; font-size:0.8rem;"></span>
            </div>

            <div class="form-group">
                <label>Status</label>
                <div class="toggle-row">
                    <span class="toggle-label">Active Pharmacy</span>
                    <label class="toggle">
                        <input asp-for="Input.IsActive" type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
                <a asp-page="/Admin/Pharmacies" class="btn btn-cancel">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
            </div>

        </form>
    </div>
</div>