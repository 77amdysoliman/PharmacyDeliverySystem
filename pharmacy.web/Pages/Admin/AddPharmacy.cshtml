@page
@model pharmacy.web.Pages.Admin.AddPharmacyModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Add New Pharmacy";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: #eef2fb; color: #1e293b; }

    .page-wrapper { max-width: 680px; margin: 0 auto; padding: 40px 24px; }

    /* ─── Header ─────────────────────────────────────────────────── */
    .page-header { margin-bottom: 32px; }
    .back-link {
        display: inline-flex; align-items: center; gap: 6px;
        color: #64748b; font-size: 0.875rem; text-decoration: none;
        margin-bottom: 16px;
        transition: color 0.2s;
    }
    .back-link:hover { color: #2563eb; }
    .page-title    { font-size: 1.75rem; font-weight: 700; }
    .page-subtitle { font-size: 0.9rem; color: #64748b; margin-top: 4px; }

    /* ─── Card ───────────────────────────────────────────────────── */
    .form-card {
        background: #fff;
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,.07);
    }

    /* ─── Form Fields ────────────────────────────────────────────── */
    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }

    .form-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .form-label i { color: #2563eb; font-size: 0.8rem; }

    .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 0.9rem;
        font-family: 'DM Sans', sans-serif;
        color: #1e293b;
        background: #f8fafc;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
        width: 100%;
    }
    .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
        background: #fff;
    }
    .form-control.input-error { border-color: #dc2626; }

    .field-error { font-size: 0.8rem; color: #dc2626; margin-top: 2px; }

    /* ─── Note Box ───────────────────────────────────────────────── */
    .info-note {
        display: flex; align-items: flex-start; gap: 10px;
        background: #eff6ff; border: 1px solid #bfdbfe;
        border-radius: 10px; padding: 14px 16px;
        font-size: 0.85rem; color: #1d4ed8;
        margin-bottom: 24px;
    }
    .info-note i { margin-top: 2px; flex-shrink: 0; }

    /* ─── Actions ────────────────────────────────────────────────── */
    .form-actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 8px; }

    .btn {
        padding: 12px 24px; border: none; border-radius: 12px; cursor: pointer;
        font-weight: 700; font-size: 0.9rem; font-family: 'DM Sans', sans-serif;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        text-decoration: none; transition: background 0.2s, transform 0.15s;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-submit { background: #2563eb; color: #fff; }
    .btn-submit:hover { background: #1d4ed8; }
    .btn-cancel { background: #f1f5f9; color: #475569; }
    .btn-cancel:hover { background: #e2e8f0; }

    /* ─── Success Message ────────────────────────────────────────── */
    .alert-success {
        background: #dcfce7; border: 1px solid #86efac;
        border-radius: 10px; padding: 14px 16px;
        font-size: 0.875rem; color: #15803d;
        display: flex; align-items: center; gap: 8px;
        margin-bottom: 24px;
    }
</style>

<div class="page-wrapper">

    <!-- Header -->
    <div class="page-header">
        <a asp-page="/Admin/Pharmacies" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Back to Pharmacies
        </a>
        <h2 class="page-title">Add New Pharmacy</h2>
        <p class="page-subtitle">Fill in the details to register a new pharmacy</p>
    </div>

    <!-- Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    <!-- Form Card -->
    <div class="form-card">

        <div class="info-note">
            <i class="fa-solid fa-circle-info"></i>
            <span>The pharmacy will be added as <strong>Under Review</strong> and must be approved before it becomes active.</span>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()

            <!-- Name -->
            <div class="form-group">
                <label class="form-label" for="Name">
                    <i class="fa-solid fa-store"></i> Pharmacy Name
                </label>
                <input id="Name" name="Input.Name" type="text"
                       class="form-control @(ViewData.ModelState["Input.Name"]?.Errors.Count > 0 ? "input-error" : "")"
                       placeholder="e.g. El Ezaby Pharmacy"
                       value="@Model.Input.Name" />
                <span asp-validation-for="Input.Name" class="field-error"></span>
            </div>

            <!-- Address -->
            <div class="form-group">
                <label class="form-label" for="Address">
                    <i class="fa-solid fa-location-dot"></i> Address
                </label>
                <input id="Address" name="Input.Address" type="text"
                       class="form-control @(ViewData.ModelState["Input.Address"]?.Errors.Count > 0 ? "input-error" : "")"
                       placeholder="e.g. 123 Tahrir Square, Cairo"
                       value="@Model.Input.Address" />
                <span asp-validation-for="Input.Address" class="field-error"></span>
            </div>

            <!-- Phone -->
            <div class="form-group">
                <label class="form-label" for="Phone">
                    <i class="fa-solid fa-phone"></i> Phone Number
                </label>
                <input id="Phone" name="Input.Phone" type="tel"
                       class="form-control @(ViewData.ModelState["Input.Phone"]?.Errors.Count > 0 ? "input-error" : "")"
                       placeholder="e.g. 0201234567"
                       value="@Model.Input.Phone" />
                <span asp-validation-for="Input.Phone" class="field-error"></span>
            </div>

            <!-- Actions -->
            <div class="form-actions">
                <a asp-page="/Admin/Pharmacies" class="btn btn-cancel">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
                <button type="submit" class="btn btn-submit">
                    <i class="fa-solid fa-plus"></i> Add Pharmacy
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
