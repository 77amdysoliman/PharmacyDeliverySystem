@page
@model pharmacy.web.Pages.Orders.OrdersModel
@{
    ViewData["Title"] = "Search for Medicine";
}

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #eef2f9; color: #1e293b; }
    .page-wrapper { max-width: 900px; margin: 0 auto; padding: 40px 20px 60px; }
    .page-header { text-align: center; margin-bottom: 28px; }
    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #0f172a; }
    .page-header p { font-size: 0.875rem; color: #64748b; margin-top: 6px; }

    .search-card { background:#fff; border-radius:16px; padding:16px 20px; box-shadow:0 1px 6px rgba(0,0,0,.07); margin-bottom:16px; }
    .search-inner { display:flex; align-items:center; gap:10px; border:1.5px solid #e2e8f0; border-radius:12px; padding:11px 16px; background:#f8fafc; }
    .search-inner input { border:none; outline:none; background:transparent; font-family:inherit; font-size:0.9rem; color:#334155; width:100%; }
    .search-inner input::placeholder { color:#b0bad0; }

    .filter-wrap { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
    .filter-btn { padding:8px 16px; border-radius:20px; border:1.5px solid #e2e8f0; background:white; color:#64748b; font-size:13px; font-weight:500; cursor:pointer; text-decoration:none; transition:all .2s; }
    .filter-btn:hover, .filter-btn.active { background:#2563eb; color:white; border-color:#2563eb; }

    .avail-wrap { display:flex; gap:8px; margin-bottom:20px; }
    .avail-btn { padding:7px 16px; border-radius:20px; border:1.5px solid #e2e8f0; background:white; color:#64748b; font-size:13px; font-weight:500; cursor:pointer; text-decoration:none; transition:all .2s; }
    .avail-btn:hover { border-color:#16a34a; color:#16a34a; }
    .avail-btn.active { background:#16a34a; color:white; border-color:#16a34a; }

    .medicine-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(380px, 1fr)); gap:12px; }
    .medicine-card { background:#fff; border-radius:16px; padding:16px 20px; box-shadow:0 1px 6px rgba(0,0,0,.07); display:flex; align-items:center; gap:16px; transition:box-shadow .18s; }
    .medicine-card:hover { box-shadow:0 3px 14px rgba(0,0,0,.1); }
    .icon-box { width:48px; height:48px; min-width:48px; background:#eff6ff; border-radius:14px; display:flex; align-items:center; justify-content:center; }
    .icon-box svg { color:#3b82f6; width:22px; height:22px; }
    .med-info { flex:1; min-width:0; }
    .med-name { font-size:1rem; font-weight:700; color:#0f172a; }
    .med-cat { font-size:0.75rem; color:#64748b; margin-top:3px; }
    .med-price { font-size:0.88rem; font-weight:700; color:#2563eb; margin-top:5px; }
    .badge-avail { display:inline-block; background:#dcfce7; color:#16a34a; font-size:11px; font-weight:600; padding:2px 8px; border-radius:10px; margin-top:4px; }
    .badge-unavail { display:inline-block; background:#fee2e2; color:#dc2626; font-size:11px; font-weight:600; padding:2px 8px; border-radius:10px; margin-top:4px; }
    .badge-rx { display:inline-block; background:#fef9c3; color:#92400e; font-size:11px; font-weight:600; padding:2px 8px; border-radius:10px; margin-top:4px; margin-left:4px; }
    .btn-order { background:#16a34a; color:#fff; border:none; border-radius:10px; padding:10px 16px; font-size:0.8rem; font-weight:700; cursor:pointer; white-space:nowrap; text-decoration:none; display:inline-block; transition:background .18s; }
    .btn-order:hover { background:#15803d; color:white; }
    .btn-unavail { background:#f1f5f9; color:#94a3b8; border:none; border-radius:10px; padding:10px 16px; font-size:0.8rem; font-weight:600; cursor:not-allowed; white-space:nowrap; }
    .empty-state { text-align:center; padding:60px 20px; color:#94a3b8; font-size:0.9rem; grid-column:1/-1; }

    .pagination { display:flex; justify-content:center; align-items:center; gap:8px; margin-top:32px; flex-wrap:wrap; }
    .page-btn { padding:8px 14px; border-radius:10px; border:1.5px solid #e2e8f0; background:white; color:#334155; font-weight:500; text-decoration:none; font-size:14px; transition:all .2s; }
    .page-btn:hover { border-color:#2563eb; color:#2563eb; }
    .page-btn.active { background:#2563eb; color:white; border-color:#2563eb; font-weight:700; }
    .page-btn.disabled { pointer-events:none; color:#cbd5e1; border-color:#f1f5f9; }
    .page-info { text-align:center; margin-top:12px; color:#94a3b8; font-size:13px; }

    /* Prescription Modal */
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center; }
    .modal-overlay.open { display:flex; }
    .modal-box { background:white; border-radius:20px; padding:32px; width:100%; max-width:460px; box-shadow:0 8px 40px rgba(0,0,0,0.18); }
    .modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
    .modal-header h3 { font-size:18px; font-weight:700; color:#0f172a; }
    .modal-close { background:none; border:none; font-size:22px; cursor:pointer; color:#94a3b8; line-height:1; }
    .modal-warning { background:#fffbeb; border:1.5px solid #fbbf24; border-radius:10px; padding:14px 16px; margin-bottom:20px; }
    .modal-warning p { font-size:13px; color:#92400e; font-weight:600; margin:0; }
    .modal-label { font-size:14px; font-weight:600; color:#374151; display:block; margin-bottom:8px; }
    .modal-file { width:100%; padding:10px; border:1.5px solid #e5e7eb; border-radius:10px; font-size:14px; margin-bottom:6px; }
    .modal-error { color:#ef4444; font-size:12px; display:none; margin-bottom:14px; }
    .modal-actions { display:flex; gap:10px; margin-top:20px; }
    .btn-cancel { flex:1; padding:12px; border:1.5px solid #e2e8f0; border-radius:10px; background:white; font-weight:600; cursor:pointer; font-size:14px; }
    .btn-proceed { flex:1; padding:12px; background:#16a34a; color:white; border:none; border-radius:10px; font-weight:700; cursor:pointer; font-size:14px; }
    .btn-proceed:hover { background:#15803d; }
</style>

<!-- Prescription Upload Modal -->
<div class="modal-overlay" id="prescriptionModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3>💊 Prescription Required</h3>
            <button class="modal-close" onclick="closeModal()">✕</button>
        </div>

        <div class="modal-warning">
            <p>⚠️ This medicine requires a valid prescription before ordering.</p>
        </div>

        <label class="modal-label">Upload Prescription Image *</label>
        <input class="modal-file" type="file" id="prescriptionFile" accept="image/*"
               onchange="handleFileChange()" />
        <div class="modal-error" id="prescriptionError">Please upload a prescription image to continue.</div>

        <div id="previewWrap" style="display:none; margin-bottom:12px;">
            <img id="previewImg" src="" alt="Prescription Preview"
                 style="width:100%; border-radius:10px; border:1px solid #e5e7eb; max-height:200px; object-fit:cover;" />
        </div>

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeModal()">Cancel</button>
            <button class="btn-proceed" onclick="proceedToOrder()">Proceed to Order →</button>
        </div>
    </div>
</div>

<div class="page-wrapper">

    <div class="page-header">
        <h1>🔍 Search for Medicine</h1>
        <p>Find your medicine and order from the nearest pharmacy</p>
    </div>

    <!-- Search Bar -->
    <form method="get" id="filterForm">
        <input type="hidden" name="currentPage" value="1" />

        <div class="search-card">
            <div class="search-inner">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input name="searchQuery" value="@Model.SearchQuery"
                       type="text" placeholder="Search for medicine name..."
                       oninput="debounceSubmit()" />
            </div>
        </div>

        <!-- Category Filter -->
        <div class="filter-wrap">
            <a class="filter-btn @(string.IsNullOrEmpty(Model.CategoryFilter) || Model.CategoryFilter == "all" ? "active" : "")"
               href="?searchQuery=@Model.SearchQuery&categoryFilter=all&availFilter=@Model.AvailFilter&currentPage=1">
                🏷️ All
            </a>
            @foreach (var cat in Model.Categories)
            {
                <a class="filter-btn @(Model.CategoryFilter?.ToLower() == cat.Name.ToLower() ? "active" : "")"
                   href="?searchQuery=@Model.SearchQuery&categoryFilter=@cat.Name&availFilter=@Model.AvailFilter&currentPage=1">
                    @cat.Name
                </a>
            }
        </div>

        <!-- Availability Filter -->
        <div class="avail-wrap">
            <a class="avail-btn @(string.IsNullOrEmpty(Model.AvailFilter) || Model.AvailFilter == "all" ? "active" : "")"
               href="?searchQuery=@Model.SearchQuery&categoryFilter=@Model.CategoryFilter&availFilter=all&currentPage=1">
                All Medicines
            </a>
            <a class="avail-btn @(Model.AvailFilter == "available" ? "active" : "")"
               href="?searchQuery=@Model.SearchQuery&categoryFilter=@Model.CategoryFilter&availFilter=available&currentPage=1">
                ✅ Available Only
            </a>
        </div>
    </form>

    <!-- Medicine Grid -->
    <div class="medicine-grid">
        @if (!Model.Medicines.Any())
        {
            <div class="empty-state">No medicines found.</div>
        }
        else
        {
            @foreach (var m in Model.Medicines)
            {
                <div class="medicine-card">
                    <div class="icon-box">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/>
                            <path d="M8 12h8M12 8v8"/>
                        </svg>
                    </div>
                    <div class="med-info">
                        <div class="med-name">@m.Name</div>
                        <div class="med-cat">@m.CategoryName</div>
                        <div class="med-price">@m.Price.ToString("F0") EGP</div>
                        @if (m.IsAvailable)
                        {
                            <span class="badge-avail">✅ Available • Stock: @m.Stock</span>
                        }
                        else
                        {
                            <span class="badge-unavail">❌ Out of Stock</span>
                        }
                        @if (m.RequiresPrescription)
                        {
                            <span class="badge-rx">📋 Prescription Required</span>
                        }
                    </div>
                    @if (m.IsAvailable)
                    {
                    @if (m.RequiresPrescription)
{
    <button class="btn-order"
            data-order-url="/Orders/NearestPharmacies?medicineId=@m.Id&medicineName=@Uri.EscapeDataString(m.Name)&medicinePrice=@m.Price&latitude=@Model.UserLatitude&longitude=@Model.UserLongitude"
            onclick="openPrescriptionModal(this.dataset.orderUrl)">
        Order Now
    </button>
}
                        else
                        {
                            <a class="btn-order"
                               asp-page="/Orders/NearestPharmacies"
                               asp-route-medicineId="@m.Id"
                               asp-route-medicineName="@m.Name"
                               asp-route-medicinePrice="@m.Price"
                               asp-route-latitude="@Model.UserLatitude"
                               asp-route-longitude="@Model.UserLongitude">
                                Order Now
                            </a>
                        }
                    }
                    else
                    {
                        <button class="btn-unavail" disabled>Not Available</button>
                    }
                </div>
            }
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            <a class="page-btn @(Model.CurrentPage == 1 ? "disabled" : "")"
               href="?searchQuery=@Model.SearchQuery&categoryFilter=@Model.CategoryFilter&availFilter=@Model.AvailFilter&currentPage=@(Model.CurrentPage - 1)">
                ← Prev
            </a>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a class="page-btn @(i == Model.CurrentPage ? "active" : "")"
                   href="?searchQuery=@Model.SearchQuery&categoryFilter=@Model.CategoryFilter&availFilter=@Model.AvailFilter&currentPage=@i">
                    @i
                </a>
            }

            <a class="page-btn @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"
               href="?searchQuery=@Model.SearchQuery&categoryFilter=@Model.CategoryFilter&availFilter=@Model.AvailFilter&currentPage=@(Model.CurrentPage + 1)">
                Next →
            </a>
        </div>

        <div class="page-info">
            Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) of @Model.TotalCount medicines
        </div>
    }

</div>

<script>
    let searchTimer;
    let pendingOrderUrl = '';

    function debounceSubmit() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            document.getElementById('filterForm').submit();
        }, 500);
    }
function openPrescriptionModal(orderUrl) {
    console.log('URL received:', orderUrl);
    pendingOrderUrl = orderUrl;
    document.getElementById('prescriptionFile').value = '';
    document.getElementById('prescriptionError').style.display = 'none';
    document.getElementById('previewWrap').style.display = 'none';
    document.getElementById('previewImg').src = '';
    document.getElementById('prescriptionModal').classList.add('open');
}
    function closeModal() {
        document.getElementById('prescriptionModal').classList.remove('open');
        pendingOrderUrl = '';
    }

    function handleFileChange() {
        const file = document.getElementById('prescriptionFile').files[0];
        document.getElementById('prescriptionError').style.display = 'none';

        if (file) {
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('previewWrap').style.display = 'block';
            };
            reader.readAsDataURL(file);
        } else {
            document.getElementById('previewWrap').style.display = 'none';
        }
    }
function proceedToOrder() {
    const file = document.getElementById('prescriptionFile').files[0];

    if (!file) {
        document.getElementById('prescriptionError').style.display = 'block';
        return;
    }

    const reader = new FileReader();
    reader.onload = e => {
        // ✅ حفظ في sessionStorage مؤقتاً
        sessionStorage.setItem('prescriptionImage', e.target.result);
        sessionStorage.setItem('prescriptionFileName', file.name);

        // Navigate للصفحة الجاية
        window.location.href = pendingOrderUrl;
    };
    reader.readAsDataURL(file);
}

    // Close modal when clicking outside
    document.getElementById('prescriptionModal').addEventListener('click', function (e) {
        if (e.target === this) closeModal();
    });
</script>