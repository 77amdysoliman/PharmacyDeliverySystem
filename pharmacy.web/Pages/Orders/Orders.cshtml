@page
@model pharmacy.web.Pages.Orders.OrdersModel
@{
    ViewData["Title"] = "Search for Medicine";
}

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #eef2f9;
        color: #1e293b;
    }

    .page-wrapper {
        max-width: 760px;
        margin: 0 auto;
        padding: 40px 20px 60px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 28px;
    }

        .page-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: #0f172a;
        }

        .page-header p {
            font-size: 0.875rem;
            color: #64748b;
            margin-top: 6px;
        }

    .search-card {
        background: #fff;
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: 0 1px 6px rgba(0,0,0,.07);
        margin-bottom: 20px;
    }

    .search-inner {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 11px 16px;
        background: #f8fafc;
        transition: border-color .2s;
    }

        .search-inner:focus-within {
            border-color: #3b82f6;
            background: #fff;
        }

        .search-inner svg {
            color: #94a3b8;
            flex-shrink: 0;
        }

        .search-inner input {
            border: none;
            outline: none;
            background: transparent;
            font-family: inherit;
            font-size: 0.9rem;
            color: #334155;
            width: 100%;
        }

            .search-inner input::placeholder {
                color: #b0bad0;
            }

    .medicine-card {
        background: #fff;
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: 0 1px 6px rgba(0,0,0,.07);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: box-shadow .18s;
    }

        .medicine-card:hover {
            box-shadow: 0 3px 14px rgba(0,0,0,.1);
        }

    .icon-box {
        width: 48px;
        height: 48px;
        min-width: 48px;
        background: #eff6ff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .icon-box svg {
            color: #3b82f6;
            width: 22px;
            height: 22px;
        }

    .med-info {
        flex: 1;
        min-width: 0;
    }

    .med-name {
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
    }

    .med-cat {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 3px;
    }

    .med-price {
        font-size: 0.88rem;
        font-weight: 700;
        color: #2563eb;
        margin-top: 7px;
    }

    .btn-order {
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        font-family: inherit;
        text-decoration: none;
        display: inline-block;
        transition: background .18s;
    }

        .btn-order:hover {
            background: #15803d;
        }

    .btn-unavail {
        background: #f1f5f9;
        color: #94a3b8;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: not-allowed;
        white-space: nowrap;
        font-family: inherit;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #94a3b8;
        font-size: 0.9rem;
    }
</style>

<div class="page-wrapper">

    <div class="page-header">
        <h1>Search for Medicine</h1>
        <p>Type the medicine name to search</p>
    </div>

    <div class="search-card">
        <div class="search-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input id="searchInput" type="text" placeholder="Search for medicine..."
                   oninput="filterMedicines()" />
        </div>
    </div>

    <div id="medicineList">
        @if (!Model.Medicines.Any())
        {
            <div class="empty-state">No medicines found.</div>
        }
        else
        {
            foreach (var m in Model.Medicines)
            {
                <div class="medicine-card"
                     data-name="@m.Name.ToLower()"
                     data-cat="@(m.CategoryName?.ToLower() ?? "")">

                    <div class="icon-box">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z" />
                            <path d="M8 12h8M12 8v8" />
                        </svg>
                    </div>

                    <div class="med-info">
                        <div class="med-name">@m.Name</div>
                        <div class="med-cat">@m.CategoryName</div>
                        <div class="med-price">@m.Price.ToString("F0") EGP</div>
                    </div>

                    @if (m.IsAvailable)
                    {
                        <a class="btn-order" href="/Orders/NearestPharmacies?medicineId=@m.Id">
                            Available - Order Now
                        </a>
                    }
                    else
                    {
                        <button class="btn-unavail" disabled>Not Available</button>
                    }
                </div>
            }
        }
    </div>

</div>

<script>
    function filterMedicines() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('#medicineList .medicine-card').forEach(card => {
            const name = card.getAttribute('data-name') || '';
            const cat  = card.getAttribute('data-cat')  || '';
            card.style.display = (name.includes(q) || cat.includes(q)) ? '' : 'none';
        });
    }
</script>
